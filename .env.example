# ==============================================================================
# Mailbunker_MCP Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Zero-Trust Security & Master Password (REQUIRED)
# ------------------------------------------------------------------------------
# Master password used for AES-256-GCM / Argon2id encryption of all stored emails,
# search payloads, and vault data.
VAULT_PASSWORD=your-super-secure-master-password-here

# Optional base directory for encrypted database and files (default: ./data)
STORAGE_PATH=./data

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Fallback polling interval in minutes if IMAP IDLE is unavailable or disconnected
SYNC_INTERVAL_MINUTES=15

# Automatically export unencrypted Obsidian notes when emails arrive (true/false)
# If false, vault is stored in encrypted format and can be exported on demand via CLI or MCP
OBSIDIAN_AUTO_EXPORT=false
OBSIDIAN_VAULT_PATH=./obsidian_vault

# ------------------------------------------------------------------------------
# 2. Email Accounts (Configure Mail 1 through 5, or more)
# ------------------------------------------------------------------------------

# --- Account 1 (e.g. Work IMAP / iCloud) ---
MAIL_1_ENABLED=true
MAIL_1_NAME=Work
MAIL_1_HOST=imap.example.com
MAIL_1_PORT=993
MAIL_1_USER=user1@example.com
MAIL_1_PASSWORD=your_password_or_app_token
MAIL_1_SSL=true
# Folders to sync/push separated by comma. Default: INBOX
MAIL_1_FOLDERS=INBOX,Sent

# --- Account 2 (e.g. Personal IMAP / Posteo / Mailbox / Hetzner) ---
MAIL_2_ENABLED=false
MAIL_2_NAME=Personal
MAIL_2_HOST=imap.posteo.de
MAIL_2_PORT=993
MAIL_2_USER=user2@posteo.de
MAIL_2_PASSWORD=your_app_password
MAIL_2_SSL=true
MAIL_2_FOLDERS=INBOX

# --- Account 3 (e.g. Gmail with App Password) ---
MAIL_3_ENABLED=false
MAIL_3_NAME=GoogleMail
MAIL_3_HOST=imap.gmail.com
MAIL_3_PORT=993
MAIL_3_USER=user3@gmail.com
MAIL_3_PASSWORD=your_google_app_password
MAIL_3_SSL=true
MAIL_3_FOLDERS=INBOX,[Gmail]/Sent Mail

# --- Account 4 ---
MAIL_4_ENABLED=false
MAIL_4_NAME=SideProject
MAIL_4_HOST=imap.strato.de
MAIL_4_PORT=993
MAIL_4_USER=user4@project.com
MAIL_4_PASSWORD=your_password
MAIL_4_SSL=true
MAIL_4_FOLDERS=INBOX

# --- Account 5 ---
MAIL_5_ENABLED=false
MAIL_5_NAME=ArchiveMail
MAIL_5_HOST=imap.mailbox.org
MAIL_5_PORT=993
MAIL_5_USER=user5@mailbox.org
MAIL_5_PASSWORD=your_password
MAIL_5_SSL=true
MAIL_5_FOLDERS=INBOX
